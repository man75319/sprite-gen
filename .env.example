# sprite-gen settings for this machine. Copy this file to `.env` (beside pyproject.toml) and fill it in.
# `.env` is ignored by git: never commit it. `sprite-gen` reads it on start (sprite_gen/util/env_file.py);
# a variable already set in the shell wins over the file. One KEY=VALUE per line; ${NAME} reuses an earlier line.

# DMXAPI relay key (dmxapi.cn -> 令牌). The dmx provider (Doubao Seedream images, Seedance clips) reads DMX_API_KEY;
# the openai provider and the xai provider (the facing check) go through the same relay with the same key.
DMX_API_KEY=
OPENAI_API_KEY=${DMX_API_KEY}
XAI_API_KEY=${DMX_API_KEY}

# The relay's address for the openai and xai providers (up to /v1, no trailing path).
SPRITE_GEN_OPENAI_BASE_URL=https://www.dmxapi.cn/v1
SPRITE_GEN_XAI_BASE_URL=${SPRITE_GEN_OPENAI_BASE_URL}

# Image model for the openai provider (see https://www.dmxapi.cn/v1/models).
SPRITE_GEN_IMAGE_MODEL=gpt-image-2.5-flare

# API keys only: never the ~/.grok or codex subscription logins.
SPRITE_GEN_LOGINS=off
