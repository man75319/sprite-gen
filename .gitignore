/.env
# Personal scratch, never the place for a script the project uses (those live in scripts/).
/local/
# Runs and their artifacts: clips, frames, atlases, GIFs (gigabytes).
/work/
# Downloaded tools (ffmpeg, libwebp, RIFE): binaries, not source.
/.tools/

# sprite-gen defaults kept in the checkout (SPRITE_GEN_CONFIG_DIR in .env)
/.sprite-gen-config/
# Studio Web (docs/char.md section 5): its Node dependencies and its build.
/studio/node_modules/
/studio/dist/
